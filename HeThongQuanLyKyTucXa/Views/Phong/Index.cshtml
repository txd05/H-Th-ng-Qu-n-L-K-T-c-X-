@model IEnumerable<KyTucXaManagement.Models.Phong>
@{
    ViewData["Title"] = "Quản lý phòng";
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <select name="toaNha" class="form-select form-select-sm">
                    <option value="">-- Tòa nhà --</option>
                    @foreach (var t in ViewBag.DanhSachToaNha ?? new List<string>())
                    {
                        <option value="@t" selected="@(ViewBag.ToaNha == t)">Tòa @t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="trangThai" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <option value="Còn chỗ">Còn chỗ</option>
                    <option value="Đầy">Đầy</option>
                    <option value="Đang sửa chữa">Đang sửa chữa</option>
                    <option value="Đóng cửa">Đóng cửa</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-filter"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x"></i></a>
                <a asp-action="Create" class="btn btn-success btn-sm ms-auto"><i class="bi bi-plus-circle"></i> Thêm phòng</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    @foreach (var p in Model)
    {
        var pct = p.SucChua > 0 ? (int)((double)p.SoNguoiHienTai / p.SucChua * 100) : 0;
        var color = p.TrangThai == "Còn chỗ" ? "success" : p.TrangThai == "Đầy" ? "danger" : "warning";
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-0 fw-bold">Phòng @p.MaPhong</h6>
                            <small class="text-muted">Tòa @p.ToaNha - Tầng @p.Tang</small>
                        </div>
                        <span class="badge bg-@color">@p.TrangThai</span>
                    </div>
                    <div class="row g-1 small mb-2">
                        <div class="col-6"><i class="bi bi-people me-1 text-muted"></i>@p.SoNguoiHienTai/@p.SucChua người</div>
                        <div class="col-6"><i class="bi bi-gender-ambiguous me-1 text-muted"></i>@p.GioiTinh</div>
                        <div class="col-6"><i class="bi bi-tag me-1 text-muted"></i>@p.LoaiPhong</div>
                        <div class="col-6"><i class="bi bi-cash me-1 text-muted"></i>@string.Format("{0:N0}", p.GiaPhong)đ</div>
                    </div>
                    <div class="progress mb-3" style="height:6px">
                        <div class="progress-bar bg-@color" style="width:@pct%"></div>
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary flex-fill"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning flex-fill"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="flex-fill"
                              onsubmit="return confirm('Xóa phòng @p.MaPhong?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
