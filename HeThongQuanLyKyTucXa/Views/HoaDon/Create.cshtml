@model KyTucXaManagement.Models.HoaDon
@{
    ViewData["Title"] = "Tạo hóa đơn";
}
<div class="card" style="max-width:600px">
    <div class="card-header bg-success text-white"><i class="bi bi-receipt me-2"></i>Tạo hóa đơn mới</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SinhVienId" class="form-label fw-semibold small">Sinh viên</label>
                    <select asp-for="SinhVienId" asp-items="ViewBag.SinhViens" class="form-select form-select-sm">
                        <option value="">-- Chọn sinh viên --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhongId" class="form-label fw-semibold small">Phòng</label>
                    <select asp-for="PhongId" asp-items="ViewBag.Phongs" class="form-select form-select-sm">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Thang" class="form-label fw-semibold small"></label>
                    <input asp-for="Thang" class="form-control form-control-sm" type="number" min="1" max="12" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Nam" class="form-label fw-semibold small"></label>
                    <input asp-for="Nam" class="form-control form-control-sm" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="HanThanhToan" class="form-label fw-semibold small"></label>
                    <input asp-for="HanThanhToan" class="form-control form-control-sm" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TienPhong" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm"><input asp-for="TienPhong" class="form-control" type="number" /><span class="input-group-text">đ</span></div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TienDien" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm"><input asp-for="TienDien" class="form-control" type="number" /><span class="input-group-text">đ</span></div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TienNuoc" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm"><input asp-for="TienNuoc" class="form-control" type="number" /><span class="input-group-text">đ</span></div>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhiKhac" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm"><input asp-for="PhiKhac" class="form-control" type="number" /><span class="input-group-text">đ</span></div>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label fw-semibold small"></label>
                    <textarea asp-for="GhiChu" class="form-control form-control-sm" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i>Tạo hóa đơn</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
