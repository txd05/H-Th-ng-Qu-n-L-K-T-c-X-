@model KyTucXaManagement.Models.HoaDon
@{
    ViewData["Title"] = "Chỉnh sửa hóa đơn";
}
<div class="card" style="max-width:600px">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-pencil-fill text-warning"></i>
        <span class="fw-bold">Chỉnh sửa hóa đơn — <code>@Model.MaHoaDon</code></span>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MaHoaDon" />
            <input type="hidden" asp-for="TrangThai" />
            <input type="hidden" asp-for="NgayLap" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SinhVienId" class="form-label">Sinh viên</label>
                    <select asp-for="SinhVienId" asp-items="ViewBag.SinhViens" class="form-select form-select-sm">
                        <option value="">-- Chọn sinh viên --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhongId" class="form-label">Phòng</label>
                    <select asp-for="PhongId" asp-items="ViewBag.Phongs" class="form-select form-select-sm">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Thang" class="form-label"></label>
                    <input asp-for="Thang" class="form-control form-control-sm" type="number" min="1" max="12" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Nam" class="form-label"></label>
                    <input asp-for="Nam" class="form-control form-control-sm" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="HanThanhToan" class="form-label"></label>
                    <input asp-for="HanThanhToan" class="form-control form-control-sm" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TienPhong" class="form-label"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="TienPhong" class="form-control" type="number" min="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TienDien" class="form-label"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="TienDien" class="form-control" type="number" min="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TienNuoc" class="form-label"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="TienNuoc" class="form-control" type="number" min="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhiKhac" class="form-label"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="PhiKhac" class="form-control" type="number" min="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control form-control-sm" rows="2"></textarea>
                </div>
            </div>
            <!-- Preview tổng -->
            <div class="alert alert-info mt-3 py-2 d-flex justify-content-between align-items-center">
                <span class="small fw-semibold">Tổng tiền dự kiến:</span>
                <span class="fw-bold" id="previewTong">—</span>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save me-1"></i>Lưu thay đổi
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function updateTong() {
        const p = parseFloat(document.getElementById('TienPhong')?.value) || 0;
        const d = parseFloat(document.getElementById('TienDien')?.value) || 0;
        const n = parseFloat(document.getElementById('TienNuoc')?.value) || 0;
        const k = parseFloat(document.getElementById('PhiKhac')?.value) || 0;
        const tong = p + d + n + k;
        document.getElementById('previewTong').textContent = tong.toLocaleString('vi-VN') + 'đ';
    }
    ['TienPhong','TienDien','TienNuoc','PhiKhac'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', updateTong);
    });
    updateTong();
</script>
}
