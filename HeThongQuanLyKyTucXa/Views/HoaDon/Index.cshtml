@model IEnumerable<KyTucXaManagement.Models.HoaDon>
@{
    ViewData["Title"] = "Quản lý hóa đơn";
}

<!-- Filter bar -->
<div class="card mb-4">
    <div class="card-body py-3 px-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label mb-1">Tháng</label>
                <input type="number" name="thang" class="form-control" placeholder="VD: 6"
                       value="@ViewBag.Thang" min="1" max="12" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label mb-1">Năm</label>
                <input type="number" name="nam" class="form-control" placeholder="VD: 2025"
                       value="@ViewBag.Nam" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Trạng thái</label>
                @{ string tt = ViewBag.TrangThai as string ?? ""; }
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    @if (tt == "Chưa thanh toán") { <option value="Chưa thanh toán" selected>Chưa thanh toán</option> }
                    else { <option value="Chưa thanh toán">Chưa thanh toán</option> }
                    @if (tt == "Đã thanh toán") { <option value="Đã thanh toán" selected>Đã thanh toán</option> }
                    else { <option value="Đã thanh toán">Đã thanh toán</option> }
                    @if (tt == "Quá hạn") { <option value="Quá hạn" selected>Quá hạn</option> }
                    else { <option value="Quá hạn">Quá hạn</option> }
                </select>
            </div>
            <div class="col-12 col-md-5 d-flex gap-2 align-items-end flex-wrap">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i> Xóa lọc
                </a>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle-fill me-1"></i> Tạo HĐ
                </a>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalLapHD">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Lập tự động
                </button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.TongTienChuaThanhToan > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span>Tổng số tiền chưa thanh toán: <strong>@string.Format("{0:N0}đ", ViewBag.TongTienChuaThanhToan)</strong></span>
    </div>
}

<!-- Table card -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-receipt-cutoff me-2 text-success"></i>Danh sách hóa đơn
        </span>
        <span class="badge" style="background:#D1FAE5;color:#065F46;font-size:.8rem;padding:5px 12px;border-radius:20px">
            @Model.Count() hóa đơn
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Sinh viên</th>
                        <th>Phòng</th>
                        <th>Tháng/Năm</th>
                        <th>Tiền phòng</th>
                        <th>Điện + Nước</th>
                        <th>Tổng</th>
                        <th>Hạn TT</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hd in Model)
                    {
                        var tong = hd.TienPhong + hd.TienDien + hd.TienNuoc + hd.PhiKhac;
                        var isQuaHan = hd.TrangThai == "Chưa thanh toán" && hd.HanThanhToan < DateTime.Now;
                        <tr @(isQuaHan ? "style=background:#FFF5F5" : "")>
                            <td><code>@hd.MaHoaDon</code></td>
                            <td class="fw-semibold">@hd.SinhVien?.HoTen</td>
                            <td>
                                @if (hd.Phong != null)
                                {
                                    <span class="badge" style="background:#EFF6FF;color:#1E40AF">@hd.Phong.MaPhong</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="fw-semibold">@hd.Thang/@hd.Nam</td>
                            <td class="text-muted">@string.Format("{0:N0}", hd.TienPhong)đ</td>
                            <td class="text-muted">@string.Format("{0:N0}", hd.TienDien + hd.TienNuoc)đ</td>
                            <td class="fw-bold" style="color:#1E40AF">@string.Format("{0:N0}", tong)đ</td>
                            <td class="small text-muted">@hd.HanThanhToan?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (isQuaHan)
                                {
                                    <span class="badge" style="background:#FEE2E2;color:#991B1B">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn
                                    </span>
                                }
                                else if (hd.TrangThai == "Đã thanh toán")
                                {
                                    <span class="badge" style="background:#D1FAE5;color:#065F46">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#FEF3C7;color:#92400E">
                                        <i class="bi bi-clock-fill me-1"></i>Chưa thanh toán
                                    </span>
                                }
                            </td>
                            <td>
                                @if (hd.TrangThai != "Đã thanh toán")
                                {
                                    <div class="d-flex gap-1">
                                        <form asp-action="XacNhanThanhToan" asp-route-id="@hd.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Xác nhận thanh toán hóa đơn này?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" title="Xác nhận TT">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@hd.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa hóa đơn này?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#059669;font-size:.82rem"><i class="bi bi-check-all"></i></span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <i class="bi bi-receipt fs-2 d-block mb-2 text-muted"></i>
                                <span class="text-muted">Không có hóa đơn nào.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal lập hóa đơn tự động -->
<div class="modal fade" id="modalLapHD" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">
                    <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Lập hóa đơn tự động
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="LapHoaDonTuDong" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tháng</label>
                        <input type="number" name="thang" class="form-control" value="@DateTime.Now.Month" min="1" max="12" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Năm</label>
                        <input type="number" name="nam" class="form-control" value="@DateTime.Now.Year" />
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Hệ thống tự động lập hóa đơn dựa trên chỉ số điện/nước đã nhập.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Lập ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
