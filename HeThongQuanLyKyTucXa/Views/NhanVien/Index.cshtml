@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-person-badge-fill me-2 text-primary"></i>Quản lý Nhân viên
        </h4>
        <p class="text-muted small mb-0">Danh sách tài khoản nhân viên trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm nhân viên
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Email</th>
                        <th>Tên tài khoản</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-person-x fs-2 d-block mb-2 text-muted"></i>
                                <span class="text-muted">Chưa có nhân viên nào.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var nv in Model)
                        {
                            bool biKhoa = nv.LockoutEnd.HasValue && nv.LockoutEnd > DateTimeOffset.UtcNow;
                            <tr>
                                <td class="text-muted small">@(stt++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2563EB,#1E40AF);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.8rem;flex-shrink:0">
                                            @(nv.Email?.Length > 0 ? nv.Email[0].ToString().ToUpper() : "N")
                                        </div>
                                        <span class="fw-semibold">@nv.Email</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@nv.UserName</td>
                                <td>
                                    @if (biKhoa)
                                    {
                                        <span class="badge" style="background:#FEE2E2;color:#991B1B">
                                            <i class="bi bi-lock-fill me-1"></i>Bị khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#D1FAE5;color:#065F46">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                                        <!-- Khóa / Mở khóa -->
                                        <form asp-action="ToggleKhoa" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm @(biKhoa ? "btn-outline-success" : "btn-outline-warning")"
                                                    onclick="return confirm('@(biKhoa ? "Mở khóa tài khoản này?" : "Khóa tài khoản này?")')">
                                                <i class="bi @(biKhoa ? "bi-unlock-fill" : "bi-lock-fill") me-1"></i>
                                                @(biKhoa ? "Mở khóa" : "Khóa")
                                            </button>
                                        </form>

                                        <!-- Reset mật khẩu -->
                                        <form asp-action="ResetPassword" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                                    onclick="return confirm('Reset mật khẩu về NhanVien@123?')">
                                                <i class="bi bi-key-fill me-1"></i> Reset MK
                                            </button>
                                        </form>

                                        <!-- Xóa -->
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Xóa vĩnh viễn tài khoản @nv.Email?')">
                                                <i class="bi bi-trash-fill me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Tổng: <strong>@(Model?.Count ?? 0)</strong> nhân viên
    </div>
</div>
