<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Ký Túc Xá</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --primary: #2563EB;
            --primary-dark: #1E40AF;
            --accent: #10B981;
            --danger: #EF4444;
            --bg: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --sidebar-from: #1E3A8A;
            --sidebar-to: #1E40AF;
            --topbar-h: 64px;
            --transition: all 0.2s cubic-bezier(.4,0,.2,1);
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: #1E293B;
            font-size: 0.9rem;
        }

        /* ─── SIDEBAR ─── */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(175deg, var(--sidebar-from) 0%, var(--sidebar-to) 100%);
            position: fixed;
            top: 0; left: 0;
            z-index: 1050;
            overflow-y: auto;
            overflow-x: hidden;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.3); border-radius: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }

        /* Brand */
        .sidebar-brand {
            display: flex; align-items: center; gap: 12px;
            padding: 22px 20px 18px;
            border-bottom: 1px solid rgba(255,255,255,.1);
            text-decoration: none;
        }
        .brand-icon {
            width: 42px; height: 42px;
            background: rgba(255,255,255,.15);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: #fff;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.2);
        }
        .brand-text h6 {
            color: #fff; font-weight: 700; font-size: 0.95rem;
            margin: 0; line-height: 1.3;
        }
        .brand-text p {
            color: rgba(255,255,255,.55); font-size: 0.72rem;
            margin: 0; letter-spacing: .3px;
        }

        /* Nav sections */
        .nav-section-title {
            color: rgba(255,255,255,.35);
            font-size: 0.67rem;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            padding: 16px 20px 6px;
        }

        .sidebar .nav-link {
            display: flex; align-items: center; gap: 10px;
            color: rgba(255,255,255,.7);
            padding: 9px 14px;
            margin: 1px 10px;
            border-radius: 10px;
            font-size: 0.87rem;
            font-weight: 500;
            transition: var(--transition);
            text-decoration: none;
            white-space: nowrap;
        }
        .sidebar .nav-link .nav-icon {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px;
            background: rgba(255,255,255,.08);
            font-size: 0.95rem;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .sidebar .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.12);
        }
        .sidebar .nav-link:hover .nav-icon {
            background: rgba(255,255,255,.2);
        }
        .sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,.18);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.15);
        }
        .sidebar .nav-link.active .nav-icon {
            background: rgba(255,255,255,.25);
        }

        /* Sidebar footer */
        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid rgba(255,255,255,.1);
            margin-top: 8px;
        }

        /* ─── MAIN CONTENT ─── */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex; flex-direction: column;
        }

        /* ─── TOPBAR ─── */
        .topbar {
            height: var(--topbar-h);
            background: var(--card-bg);
            border-bottom: 1px solid var(--border);
            padding: 0 28px;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 999;
            box-shadow: 0 1px 8px rgba(0,0,0,.06);
        }
        .topbar-title {
            font-weight: 700; font-size: 1.05rem;
            color: #1E293B; margin: 0;
        }
        .topbar-right { display: flex; align-items: center; gap: 12px; }

        .role-badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px; border-radius: 20px;
            font-size: 0.72rem; font-weight: 700; letter-spacing: .4px;
        }
        .role-badge.admin    { background: #FEE2E2; color: #991B1B; }
        .role-badge.nhanvien { background: #DBEAFE; color: #1E40AF; }
        .role-badge.sinhvien { background: #D1FAE5; color: #065F46; }

        .user-info {
            display: flex; align-items: center; gap: 8px;
        }
        .user-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 700; font-size: 0.85rem;
            flex-shrink: 0;
        }
        .user-name { font-size: 0.85rem; font-weight: 600; color: #334155; }

        .btn-logout {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; border-radius: 8px;
            background: transparent;
            border: 1.5px solid #FECACA;
            color: var(--danger);
            font-size: 0.82rem; font-weight: 600;
            cursor: pointer; transition: var(--transition);
            text-decoration: none;
        }
        .btn-logout:hover {
            background: var(--danger); color: #fff;
            border-color: var(--danger);
        }

        /* ─── PAGE CONTENT ─── */
        .page-content { padding: 28px; flex: 1; }

        /* ─── CARDS ─── */
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 1px 6px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.04);
            transition: var(--transition);
        }
        .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.09); }
        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border);
            border-radius: 16px 16px 0 0 !important;
            padding: 14px 20px;
            font-weight: 600; font-size: 0.9rem;
        }
        .card-footer {
            background: transparent;
            border-top: 1px solid var(--border);
            border-radius: 0 0 16px 16px !important;
            padding: 10px 20px;
        }

        /* Stat cards */
        .stat-card {
            border: none !important;
            border-radius: 16px;
            overflow: hidden;
            position: relative;
        }
        .stat-card .card-body { padding: 20px 22px; }
        .stat-card .stat-label {
            font-size: 0.78rem; font-weight: 600;
            letter-spacing: .3px; opacity: .85;
            text-transform: uppercase;
        }
        .stat-card .stat-number {
            font-size: 2rem; font-weight: 800;
            line-height: 1.1; margin: 4px 0 0;
        }
        .stat-card .stat-icon {
            position: absolute; right: 18px; top: 50%;
            transform: translateY(-50%);
            font-size: 3rem; opacity: .15;
        }
        .stat-card.blue   { background: linear-gradient(135deg, #2563EB, #3B82F6); color: #fff; }
        .stat-card.green  { background: linear-gradient(135deg, #059669, #10B981); color: #fff; }
        .stat-card.orange { background: linear-gradient(135deg, #D97706, #F59E0B); color: #fff; }
        .stat-card.red    { background: linear-gradient(135deg, #DC2626, #EF4444); color: #fff; }
        .stat-card.purple { background: linear-gradient(135deg, #7C3AED, #8B5CF6); color: #fff; }
        .stat-card.teal   { background: linear-gradient(135deg, #0D9488, #14B8A6); color: #fff; }
        .stat-card.indigo { background: linear-gradient(135deg, #4338CA, #6366F1); color: #fff; }

        /* ─── TABLES ─── */
        .table { font-size: 0.875rem; }
        .table th {
            font-weight: 700; font-size: 0.78rem;
            color: var(--text-muted); letter-spacing: .4px;
            text-transform: uppercase; border-bottom-width: 1px;
            padding: 11px 16px;
            background: #F8FAFC;
        }
        .table td { padding: 12px 16px; vertical-align: middle; border-color: var(--border); }
        .table-hover tbody tr:hover { background: #F1F5F9; }

        /* ─── BADGES ─── */
        .badge {
            font-size: 0.75rem; font-weight: 600;
            padding: 4px 10px; border-radius: 20px;
        }

        /* ─── BUTTONS ─── */
        .btn {
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.87rem;
            transition: var(--transition);
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none; color: #fff;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, var(--primary-dark), #1E3A8A);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(37,99,235,.35);
        }
        .btn-success {
            background: linear-gradient(135deg, #059669, var(--accent));
            border: none; color: #fff;
        }
        .btn-success:hover {
            background: linear-gradient(135deg, #047857, #059669);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(16,185,129,.35);
        }
        .btn-danger {
            background: linear-gradient(135deg, #DC2626, var(--danger));
            border: none; color: #fff;
        }
        .btn-danger:hover { transform: translateY(-1px); }

        .btn-outline-primary {
            border-color: var(--primary); color: var(--primary);
        }
        .btn-outline-primary:hover {
            background: var(--primary); border-color: var(--primary);
            transform: translateY(-1px);
        }

        .btn-sm { padding: 5px 12px; font-size: 0.8rem; border-radius: 8px; }
        .btn-xs { padding: 3px 8px; font-size: 0.75rem; border-radius: 6px; }

        /* ─── FORMS ─── */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid var(--border);
            padding: 9px 14px;
            font-size: 0.87rem;
            transition: var(--transition);
            background: var(--card-bg);
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.15);
            outline: none;
        }
        .form-control-sm, .form-select-sm {
            padding: 6px 11px;
            border-radius: 8px;
            font-size: 0.82rem;
        }
        .input-group-text {
            background: #F1F5F9;
            border: 1.5px solid var(--border);
            border-radius: 10px 0 0 10px;
            color: var(--text-muted);
        }
        .input-group .form-control { border-radius: 0 10px 10px 0; }
        .input-group .btn { border-radius: 0 10px 10px 0; }
        label.form-label { font-weight: 600; font-size: 0.83rem; color: #374151; margin-bottom: 5px; }

        /* ─── ALERTS ─── */
        .alert {
            border-radius: 12px;
            border: none;
            padding: 12px 18px;
            font-size: 0.87rem;
        }
        .alert-success { background: #D1FAE5; color: #065F46; }
        .alert-warning { background: #FEF3C7; color: #92400E; }
        .alert-danger  { background: #FEE2E2; color: #991B1B; }
        .alert-info    { background: #DBEAFE; color: #1E40AF; }

        /* ─── PROGRESS ─── */
        .progress {
            height: 8px; border-radius: 99px;
            background: #E2E8F0; overflow: hidden;
        }
        .progress-bar { border-radius: 99px; }

        /* ─── MODALS ─── */
        .modal-content {
            border: none; border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,.2);
        }
        .modal-header {
            border-bottom: 1px solid var(--border);
            padding: 18px 24px;
        }
        .modal-footer {
            border-top: 1px solid var(--border);
            padding: 14px 24px;
        }

        /* ─── UTILS ─── */
        code {
            background: #EFF6FF; color: #2563EB;
            padding: 2px 7px; border-radius: 6px;
            font-size: 0.82rem; font-weight: 600;
        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 991px) {
            .sidebar {
                transform: translateX(-100%);
                z-index: 1055;
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-content { margin-left: 0; }
            .topbar { padding: 0 16px; }
            .page-content { padding: 16px; }
        }
        @@media (max-width: 576px) {
            .topbar-title { font-size: 0.9rem; }
            .user-name { display: none; }
        }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- SIDEBAR -->
        <nav class="sidebar" id="sidebar">
            <a class="sidebar-brand" href="#">
                <div class="brand-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <div class="brand-text">
                    <h6>KTX Management</h6>
                    <p>Ký Túc Xá HUTECH</p>
                </div>
            </a>

            <div class="mt-1 pb-3">
                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                {
                    <div class="nav-section-title">Tổng quan</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() != "ThongKe" ? "active" : "")"
                       asp-controller="Admin" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>
                        Tổng quan
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "ThongKe" ? "active" : "")"
                       asp-controller="Admin" asp-action="ThongKe">
                        <span class="nav-icon"><i class="bi bi-bar-chart-line"></i></span>
                        Thống kê SV
                    </a>

                    <div class="nav-section-title">Quản lý</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")"
                       asp-controller="SinhVien" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
                        Sinh viên
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Phong" ? "active" : "")"
                       asp-controller="Phong" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-door-open-fill"></i></span>
                        Phòng
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() != "ThongKe" ? "active" : "")"
                       asp-controller="HoaDon" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-receipt-cutoff"></i></span>
                        Hóa đơn
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() == "ThongKe" ? "active" : "")"
                       asp-controller="HoaDon" asp-action="ThongKe">
                        <span class="nav-icon"><i class="bi bi-bar-chart-fill"></i></span>
                        Doanh thu
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienNuoc" ? "active" : "")"
                       asp-controller="DienNuoc" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                        Điện / Nước
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaiSan" && ViewContext.RouteData.Values["action"]?.ToString() != "SuCo" ? "active" : "")"
                       asp-controller="TaiSan" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-box-seam-fill"></i></span>
                        Tài sản
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SuCo" ? "active" : "")"
                       asp-controller="TaiSan" asp-action="SuCo">
                        <span class="nav-icon"><i class="bi bi-tools"></i></span>
                        Sự cố
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "DonYeuCau" ? "active" : "")"
                       asp-controller="Admin" asp-action="DonYeuCau">
                        <span class="nav-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                        Đơn yêu cầu
                        @{
                            int soDonCho = 0;
                            try {
                                var donChoDb = Context.RequestServices.GetService<KyTucXaManagement.Data.ApplicationDbContext>();
                                soDonCho = donChoDb?.DonYeuCaus.Count(d => d.TrangThai == "Chờ duyệt") ?? 0;
                            } catch { }
                        }
                        @if (soDonCho > 0)
                        {
                            <span class="badge bg-danger ms-auto">@soDonCho</span>
                        }
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-section-title">Hệ thống</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhanVien" ? "active" : "")"
                           asp-controller="NhanVien" asp-action="Index">
                            <span class="nav-icon"><i class="bi bi-person-badge-fill"></i></span>
                            Quản lý Nhân viên
                        </a>
                    }
                }
                else if (User.IsInRole("SinhVien"))
                {
                    <div class="nav-section-title">Sinh viên</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVienPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="SinhVienPortal" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-person-circle"></i></span>
                        Thông tin của tôi
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVienPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "HoaDon" ? "active" : "")"
                       asp-controller="SinhVienPortal" asp-action="HoaDon">
                        <span class="nav-icon"><i class="bi bi-receipt-cutoff"></i></span>
                        Hóa đơn của tôi
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVienPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "DonYeuCau" ? "active" : "")"
                       asp-controller="SinhVienPortal" asp-action="DonYeuCau">
                        <span class="nav-icon"><i class="bi bi-envelope-paper-fill"></i></span>
                        Đơn yêu cầu
                    </a>
                }
                else
                {
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <span class="nav-icon"><i class="bi bi-house-fill"></i></span>
                        Trang chủ
                    </a>
                }
            </div>
        </nav>
        <!-- Overlay for mobile -->
        <div class="sidebar-overlay d-none" id="sidebarOverlay"
             style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1040"
             onclick="toggleSidebar()"></div>
    }

    <div class="@(User.Identity?.IsAuthenticated == true ? "main-content" : "")">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <!-- Hamburger for mobile -->
                    <button class="btn btn-sm d-lg-none me-1" style="border:none;background:none;padding:4px 6px"
                            onclick="toggleSidebar()">
                        <i class="bi bi-list fs-5 text-secondary"></i>
                    </button>
                    <h6 class="topbar-title">@ViewData["Title"]</h6>
                </div>
                <div class="topbar-right">
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="role-badge admin"><i class="bi bi-shield-fill-check"></i> Admin</span>
                    }
                    else if (User.IsInRole("NhanVien"))
                    {
                        <span class="role-badge nhanvien"><i class="bi bi-person-badge-fill"></i> Nhân viên</span>
                    }
                    else if (User.IsInRole("SinhVien"))
                    {
                        <span class="role-badge sinhvien"><i class="bi bi-mortarboard-fill"></i> Sinh viên</span>
                    }

                    <div class="user-info">
                        <div class="user-avatar">
                            @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                        </div>
                        <span class="user-name d-none d-sm-inline">@User.Identity?.Name</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-sm-inline">Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="@(User.Identity?.IsAuthenticated == true ? "page-content" : "")">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@Html.Raw(TempData["Warning"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const ov = document.getElementById('sidebarOverlay');
            if (sb) sb.classList.toggle('show');
            if (ov) ov.classList.toggle('d-none');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
