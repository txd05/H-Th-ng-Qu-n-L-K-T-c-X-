@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card blue h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Sinh viên nội trú</div>
                    <div class="stat-number text-primary">@ViewBag.TongSinhVien</div>
                </div>
                <i class="bi bi-people fs-1 text-primary opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card green h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Phòng còn chỗ</div>
                    <div class="stat-number text-success">@ViewBag.PhongConCho / @ViewBag.TongPhong</div>
                </div>
                <i class="bi bi-door-open fs-1 text-success opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card orange h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Hóa đơn chưa TT</div>
                    <div class="stat-number text-warning">@ViewBag.HoaDonChuaThanhToan</div>
                </div>
                <i class="bi bi-receipt fs-1 text-warning opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card red h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Doanh thu tháng</div>
                    <div class="stat-number text-danger" style="font-size:1.3rem">@string.Format("{0:N0}đ", ViewBag.DoanhThuThang)</div>
                </div>
                <i class="bi bi-cash-stack fs-1 text-danger opacity-25"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card purple h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Sự cố chờ xử lý</div>
                    <div class="stat-number text-purple" style="color:#6f42c1">@ViewBag.SuCoChoXuLy</div>
                </div>
                <i class="bi bi-tools fs-1 opacity-25" style="color:#6f42c1"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card teal h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Đơn chờ duyệt</div>
                    <div class="stat-number" style="color:#20c997">@ViewBag.DonChoXetDuyet</div>
                </div>
                <i class="bi bi-file-earmark-text fs-1 opacity-25" style="color:#20c997"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card red h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">HĐ quá hạn</div>
                    <div class="stat-number text-danger">@ViewBag.HoaDonQuaHan</div>
                </div>
                <i class="bi bi-exclamation-triangle fs-1 text-danger opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100" style="border-radius:12px; cursor:pointer" onclick="location.href='@Url.Action("ThongKe")'">
            <div class="card-body d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-bar-chart-line fs-3"></i>
                <div>
                    <div class="fw-bold">Xem thống kê</div>
                    <div class="small opacity-75">Toàn bộ sinh viên</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people me-2 text-primary"></i>Sinh viên vào gần đây</span>
                <a asp-controller="SinhVien" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SV</th>
                                <th>Họ tên</th>
                                <th>Phòng</th>
                                <th>Ngày vào</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sv in ViewBag.SinhVienGanDay)
                            {
                                <tr>
                                    <td><code>@sv.MaSinhVien</code></td>
                                    <td>@sv.HoTen</td>
                                    <td>@(sv.Phong?.MaPhong ?? "Chưa có")</td>
                                    <td>@sv.NgayVaoKTX?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @(sv.TrangThai == "Đang nội trú" ? "bg-success" : "bg-secondary")">
                                            @sv.TrangThai
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-white">
                <i class="bi bi-pie-chart me-2 text-success"></i>Thống kê sinh viên
            </div>
            <div class="card-body">
                @foreach (var item in ViewBag.ThongKeSinhVien)
                {
                    var pct = ViewBag.TongSinhVien > 0 ? (int)((double)item.SoLuong / (double)ViewBag.TongSinhVien * 100) : 0;
                    var color = item.TrangThai == "Đang nội trú" ? "success" : item.TrangThai == "Đã rời KTX" ? "secondary" : "warning";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@item.TrangThai</span>
                            <span class="fw-semibold">@item.SoLuong</span>
                        </div>
                        <div class="progress" style="height:8px">
                            <div class="progress-bar bg-@color" style="width:@pct%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header bg-white"><i class="bi bi-lightning me-2 text-warning"></i>Thao tác nhanh</div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="SinhVien" asp-action="Create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-person-plus me-1"></i> Thêm sinh viên
                </a>
                <a asp-controller="HoaDon" asp-action="Create" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Tạo hóa đơn
                </a>
                <a asp-controller="DienNuoc" asp-action="CreateDien" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-lightning-charge me-1"></i> Ghi chỉ số điện
                </a>
                <a asp-controller="TaiSan" asp-action="CreateSuCo" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-tools me-1"></i> Báo sự cố
                </a>
            </div>
        </div>
    </div>
</div>
