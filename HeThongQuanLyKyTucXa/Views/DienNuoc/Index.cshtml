@{
    ViewData["Title"] = "Quản lý điện / nước";
    var chiSoDiens = ViewBag.ChiSoDiens as List<KyTucXaManagement.Models.ChiSoDien> ?? new();
    var chiSoNuocs = ViewBag.ChiSoNuocs as List<KyTucXaManagement.Models.ChiSoNuoc> ?? new();
    var soSvTheoPhong = ViewBag.SoSvTheoPhong as Dictionary<int, int> ?? new();
}

<!-- Filter bar -->
<div class="card mb-4">
    <div class="card-body py-3 px-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label mb-1">Tháng</label>
                <input type="number" name="thang" class="form-control" placeholder="Tháng"
                       value="@ViewBag.Thang" min="1" max="12" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label mb-1">Năm</label>
                <input type="number" name="nam" class="form-control" placeholder="Năm"
                       value="@ViewBag.Nam" />
            </div>
            <div class="col-12 col-md-8 d-flex gap-2 align-items-end flex-wrap">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel-fill me-1"></i> Xem
                </button>
                <a asp-action="CreateDien" class="btn ms-auto"
                   style="background:linear-gradient(135deg,#D97706,#F59E0B);border:none;color:#fff;border-radius:10px;font-weight:600">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Ghi điện
                </a>
                <a asp-action="CreateNuoc" class="btn"
                   style="background:linear-gradient(135deg,#0284C7,#38BDF8);border:none;color:#fff;border-radius:10px;font-weight:600">
                    <i class="bi bi-droplet-fill me-1"></i> Ghi nước
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Điện -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:linear-gradient(135deg,#D97706,#F59E0B);border-radius:16px 16px 0 0;color:#fff;border:none">
                <span>
                    <i class="bi bi-lightning-charge-fill me-2"></i>
                    Chỉ số điện — @ViewBag.Thang/@ViewBag.Nam
                </span>
                <span style="background:rgba(255,255,255,.2);color:#fff;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700">
                    @chiSoDiens.Count phòng
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Phòng</th>
                            <th>Đầu kỳ</th>
                            <th>Cuối kỳ</th>
                            <th>Tiêu thụ</th>
                            <th>Thành tiền</th>
                            <th>Số SV</th>
                            <th>Tiền/người</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cs in chiSoDiens)
                        {
                            var tieu = cs.ChiSoCuoi - cs.ChiSoDau;
                            var thanhTien = tieu * cs.DonGia;
                            var soSv = soSvTheoPhong.ContainsKey(cs.PhongId) ? soSvTheoPhong[cs.PhongId] : 0;
                            var tienMoiNguoi = soSv > 0 ? thanhTien / soSv : 0;
                            <tr>
                                <td>
                                    <span class="badge" style="background:#FEF3C7;color:#92400E">@cs.Phong?.MaPhong</span>
                                </td>
                                <td class="text-muted">@cs.ChiSoDau</td>
                                <td class="fw-semibold">@cs.ChiSoCuoi</td>
                                <td>
                                    <span class="fw-bold" style="color:#D97706">@tieu <small class="text-muted fw-normal">kWh</small></span>
                                </td>
                                <td class="fw-semibold" style="color:#92400E">@string.Format("{0:N0}", thanhTien)đ</td>
                                <td>
                                    @if (soSv > 0)
                                    {
                                        <span class="badge" style="background:#DBEAFE;color:#1E40AF">@soSv SV</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (soSv > 0)
                                    {
                                        <span class="fw-bold" style="color:#D97706">@string.Format("{0:N0}", tienMoiNguoi)đ</span>
                                        <div class="text-muted" style="font-size:.72rem">@string.Format("{0:N0}", thanhTien)đ ÷ @soSv</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có SV</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="DeleteDien" asp-route-id="@cs.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa chỉ số điện này?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!chiSoDiens.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="bi bi-lightning fs-2 d-block mb-2 text-muted"></i>
                                    <span class="text-muted small">Chưa có dữ liệu điện</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Nước -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:linear-gradient(135deg,#0284C7,#38BDF8);border-radius:16px 16px 0 0;color:#fff;border:none">
                <span>
                    <i class="bi bi-droplet-fill me-2"></i>
                    Chỉ số nước — @ViewBag.Thang/@ViewBag.Nam
                </span>
                <span style="background:rgba(255,255,255,.2);color:#fff;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700">
                    @chiSoNuocs.Count phòng
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Phòng</th>
                            <th>Đầu kỳ</th>
                            <th>Cuối kỳ</th>
                            <th>Tiêu thụ</th>
                            <th>Thành tiền</th>
                            <th>Số SV</th>
                            <th>Tiền/người</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cs in chiSoNuocs)
                        {
                            var tieu = cs.ChiSoCuoi - cs.ChiSoDau;
                            var thanhTien = tieu * cs.DonGia;
                            var soSv = soSvTheoPhong.ContainsKey(cs.PhongId) ? soSvTheoPhong[cs.PhongId] : 0;
                            var tienMoiNguoi = soSv > 0 ? thanhTien / soSv : 0;
                            <tr>
                                <td>
                                    <span class="badge" style="background:#DBEAFE;color:#1E40AF">@cs.Phong?.MaPhong</span>
                                </td>
                                <td class="text-muted">@cs.ChiSoDau</td>
                                <td class="fw-semibold">@cs.ChiSoCuoi</td>
                                <td>
                                    <span class="fw-bold" style="color:#0284C7">@tieu <small class="text-muted fw-normal">m³</small></span>
                                </td>
                                <td class="fw-semibold" style="color:#1E40AF">@string.Format("{0:N0}", thanhTien)đ</td>
                                <td>
                                    @if (soSv > 0)
                                    {
                                        <span class="badge" style="background:#DBEAFE;color:#1E40AF">@soSv SV</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (soSv > 0)
                                    {
                                        <span class="fw-bold" style="color:#0284C7">@string.Format("{0:N0}", tienMoiNguoi)đ</span>
                                        <div class="text-muted" style="font-size:.72rem">@string.Format("{0:N0}", thanhTien)đ ÷ @soSv</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có SV</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="DeleteNuoc" asp-route-id="@cs.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa chỉ số nước này?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!chiSoNuocs.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="bi bi-droplet fs-2 d-block mb-2 text-muted"></i>
                                    <span class="text-muted small">Chưa có dữ liệu nước</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
