@model KyTucXaManagement.Models.SinhVien
@{
    ViewData["Title"] = "Chỉnh sửa sinh viên";
    var danhSachPhong = ViewBag.Phongs as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="card" style="max-width:700px">
    <div class="card-header bg-warning text-dark">
        <i class="bi bi-pencil me-2"></i>Chỉnh sửa: @Model.HoTen
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaSinhVien" class="form-label fw-semibold small"></label>
                    <input asp-for="MaSinhVien" class="form-control form-control-sm" />
                    <span asp-validation-for="MaSinhVien" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold small"></label>
                    <input asp-for="HoTen" class="form-control form-control-sm" />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NgaySinh" class="form-label fw-semibold small"></label>
                    <input asp-for="NgaySinh" class="form-control form-control-sm" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="GioiTinh" class="form-label fw-semibold small"></label>
                    <select asp-for="GioiTinh" id="selectGioiTinh" class="form-select form-select-sm">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold small"></label>
                    <input asp-for="SoDienThoai" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhongId" class="form-label fw-semibold small">
                        Phòng <span id="badgeGioiTinh" class="badge ms-1">@Model.GioiTinh</span>
                    </label>
                    <select id="selectPhong" name="PhongId" class="form-select form-select-sm">
                        <option value="">-- Chưa có phòng --</option>
                        @foreach (var p in danhSachPhong)
                        {
                            <option value="@p.Id"
                                    data-gioitinh="@p.GioiTinh"
                                    data-concho="@(p.SucChua - p.SoNguoiHienTai)"
                                    selected="@(p.Id == Model.PhongId)">
                                @p.MaPhong — @p.GioiTinh (@(p.SucChua - p.SoNguoiHienTai) chỗ trống)
                            </option>
                        }
                    </select>
                    <div id="phongWarning" class="text-danger small mt-1" style="display:none">
                        <i class="bi bi-exclamation-triangle me-1"></i>Không có phòng phù hợp cho giới tính này.
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="NamHoc" class="form-label fw-semibold small"></label>
                    <select asp-for="NamHoc" class="form-select form-select-sm">
                        <option>Năm 1</option><option>Năm 2</option><option>Năm 3</option><option>Năm 4</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label fw-semibold small"></label>
                    <select asp-for="TrangThai" class="form-select form-select-sm">
                        <option>Đang nội trú</option>
                        <option>Tạm khóa</option>
                        <option>Đã rời KTX</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="QueQuan" class="form-label fw-semibold small"></label>
                    <input asp-for="QueQuan" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DienUuTien" class="form-label fw-semibold small"></label>
                    <select asp-for="DienUuTien" class="form-select form-select-sm">
                        <option value="">-- Không --</option>
                        <option>Con liệt sĩ/thương binh</option>
                        <option>Dân tộc thiểu số</option>
                        <option>Vùng sâu vùng xa</option>
                        <option>Hộ nghèo</option>
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Cập nhật</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const selectGioiTinh  = document.getElementById('selectGioiTinh');
    const selectPhong     = document.getElementById('selectPhong');
    const badge           = document.getElementById('badgeGioiTinh');
    const warning         = document.getElementById('phongWarning');
    const currentPhongId  = '@Model.PhongId'; // giá trị phòng hiện tại

    // Lưu toàn bộ options (trừ option đầu)
    const allOptions = Array.from(selectPhong.options).slice(1);

    function filterPhong(keepCurrentId) {
        const gt = selectGioiTinh.value;
        badge.textContent = gt;
        badge.className   = 'badge ms-1 ' + (gt === 'Nam' ? 'bg-primary' : 'bg-danger');

        const currentVal = selectPhong.value;

        // Xóa hết options cũ
        while (selectPhong.options.length > 1) selectPhong.remove(1);

        // Thêm phòng đúng giới tính
        const filtered = allOptions.filter(o => o.dataset.gioitinh === gt);
        filtered.forEach(o => {
            const clone = o.cloneNode(true);
            selectPhong.add(clone);
        });

        // Restore giá trị đã chọn nếu vẫn còn trong danh sách mới
        const idToRestore = keepCurrentId || currentVal;
        const exists = filtered.some(o => String(o.value) === String(idToRestore));
        if (exists) selectPhong.value = idToRestore;

        warning.style.display = filtered.length === 0 ? 'block' : 'none';
    }

    selectGioiTinh.addEventListener('change', () => filterPhong(null));

    // Khi load: filter theo giới tính hiện tại và giữ phòng đang có
    filterPhong(currentPhongId);
</script>
}
