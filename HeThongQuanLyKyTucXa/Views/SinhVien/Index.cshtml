@model IEnumerable<KyTucXaManagement.Models.SinhVien>
@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên, mã SV..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <select name="trangThai" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <option value="Đang nội trú" selected="@(ViewBag.TrangThai == "Đang nội trú")">Đang nội trú</option>
                    <option value="Đã rời KTX" selected="@(ViewBag.TrangThai == "Đã rời KTX")">Đã rời KTX</option>
                    <option value="Tạm khóa" selected="@(ViewBag.TrangThai == "Tạm khóa")">Tạm khóa</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="gioiTinh" class="form-select form-select-sm">
                    <option value="">-- Giới tính --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Tìm</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x"></i> Xóa lọc</a>
                <a asp-action="Create" class="btn btn-success btn-sm ms-auto"><i class="bi bi-person-plus"></i> Thêm mới</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between">
        <span><i class="bi bi-people me-2 text-primary"></i>Danh sách sinh viên</span>
        <span class="badge bg-primary">@Model.Count() sinh viên</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã SV</th>
                        <th>Họ tên</th>
                        <th>Giới tính</th>
                        <th>SĐT</th>
                        <th>Phòng</th>
                        <th>Ngày vào</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sv in Model)
                    {
                        <tr>
                            <td><code>@sv.MaSinhVien</code></td>
                            <td><strong>@sv.HoTen</strong></td>
                            <td>@sv.GioiTinh</td>
                            <td>@sv.SoDienThoai</td>
                            <td>@(sv.Phong?.MaPhong ?? "Chưa có")</td>
                            <td class="small">@sv.NgayVaoKTX?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(sv.TrangThai == "Đang nội trú" ? "bg-success" : "bg-secondary")">@sv.TrangThai</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@sv.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa sinh viên @sv.HoTen?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy sinh viên nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
