@model IEnumerable<KyTucXaManagement.Models.TaiSan>
@{
    ViewData["Title"] = "Quản lý tài sản";
}

<!-- Toolbar -->
<div class="card mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle-fill me-1"></i>Thêm tài sản
            </a>
            <a asp-action="SuCo" class="btn btn-danger">
                <i class="bi bi-tools me-1"></i>Sự cố
            </a>
            <div class="ms-auto">
                <select class="form-select"
                        onchange="location.href='?tinhTrang='+this.value" style="min-width:160px">
                    <option value="">Tất cả tình trạng</option>
                    <option value="Bình thường">Bình thường</option>
                    <option value="Hỏng">Hỏng</option>
                    <option value="Đang sửa">Đang sửa</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Table card -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-box-seam-fill me-2 text-warning"></i>Danh sách tài sản
        </span>
        <span class="badge" style="background:#FEF3C7;color:#92400E;font-size:.8rem;padding:5px 12px;border-radius:20px">
            @Model.Count() tài sản
        </span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Mã TS</th>
                    <th>Tên tài sản</th>
                    <th>Loại</th>
                    <th>Phòng</th>
                    <th class="text-center">SL</th>
                    <th>Giá trị</th>
                    <th>Tình trạng</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ts in Model)
                {
                    <tr>
                        <td><code>@ts.MaTaiSan</code></td>
                        <td class="fw-semibold">@ts.TenTaiSan</td>
                        <td class="text-muted">@ts.LoaiTaiSan</td>
                        <td>
                            @if (ts.Phong != null)
                            {
                                <span class="badge" style="background:#EFF6FF;color:#1E40AF">@ts.Phong.MaPhong</span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-center fw-semibold">@ts.SoLuong</td>
                        <td class="fw-semibold" style="color:#059669">@string.Format("{0:N0}đ", ts.GiaTri)</td>
                        <td>
                            @if (ts.TinhTrang == "Bình thường")
                            {
                                <span class="badge" style="background:#D1FAE5;color:#065F46">
                                    <i class="bi bi-check-circle-fill me-1"></i>Bình thường
                                </span>
                            }
                            else if (ts.TinhTrang == "Hỏng")
                            {
                                <span class="badge" style="background:#FEE2E2;color:#991B1B">
                                    <i class="bi bi-x-circle-fill me-1"></i>Hỏng
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background:#FEF3C7;color:#92400E">
                                    <i class="bi bi-tools me-1"></i>@ts.TinhTrang
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@ts.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@ts.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa tài sản @ts.TenTaiSan?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <i class="bi bi-box fs-2 d-block mb-2 text-muted"></i>
                            <span class="text-muted">Chưa có tài sản nào.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
