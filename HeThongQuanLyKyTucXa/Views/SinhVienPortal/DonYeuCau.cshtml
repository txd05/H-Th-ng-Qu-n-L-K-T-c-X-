@using KyTucXaManagement.Models
@model List<DonYeuCau>
@{
    ViewData["Title"] = "Đơn yêu cầu";
    var sinhVien = ViewBag.SinhVien as SinhVien;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-envelope-paper me-2 text-primary"></i>Đơn yêu cầu</h4>
    @if (sinhVien != null)
    {
        <p class="text-muted small mb-0">Sinh viên: <strong>@sinhVien.HoTen</strong> — Mã SV: @sinhVien.MaSinhVien</p>
    }
</div>

<div class="row g-4">
    <!-- Form gửi đơn mới -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-plus-circle me-2"></i>Gửi đơn yêu cầu mới
            </div>
            <div class="card-body">
                <form asp-action="DonYeuCau" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loại đơn <span class="text-danger">*</span></label>
                        <select name="loaiDon" class="form-select" required>
                            <option value="">-- Chọn loại đơn --</option>
                            <option value="Đăng ký KTX">Đăng ký KTX</option>
                            <option value="Gia hạn KTX">Gia hạn KTX</option>
                            <option value="Chuyển phòng">Chuyển phòng</option>
                            <option value="Rời KTX">Rời KTX</option>
                            <option value="Báo sự cố">Báo sự cố</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung <span class="text-danger">*</span></label>
                        <textarea name="noiDung" class="form-control" rows="5"
                                  placeholder="Mô tả chi tiết nội dung yêu cầu của bạn..." required
                                  maxlength="1000"></textarea>
                        <div class="form-text">Tối đa 1000 ký tự</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-2"></i>Gửi đơn yêu cầu
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Danh sách đơn đã gửi -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-list-ul me-2"></i>Đơn đã gửi
                <span class="badge bg-secondary ms-2">@(Model?.Count ?? 0)</span>
            </div>
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        Chưa có đơn yêu cầu nào
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var don in Model)
                        {
                            var badgeClass = don.TrangThai switch {
                                "Đã duyệt" => "bg-success",
                                "Từ chối" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                            var cardBorder = don.TrangThai switch {
                                "Đã duyệt" => "border-start border-success border-3",
                                "Từ chối" => "border-start border-danger border-3",
                                _ => "border-start border-warning border-3"
                            };
                            <div class="list-group-item @cardBorder p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <strong>@don.LoaiDon</strong>
                                        <span class="text-muted small ms-2">— @don.MaDon</span>
                                    </div>
                                    <span class="badge @badgeClass small">@don.TrangThai</span>
                                </div>
                                <p class="text-muted small mb-1">@don.NoiDung</p>
                                <div class="d-flex gap-3 small text-muted">
                                    <span><i class="bi bi-calendar3 me-1"></i>Ngày nộp: @don.NgayNop.ToString("dd/MM/yyyy")</span>
                                    @if (don.NgayDuyet.HasValue)
                                    {
                                        <span><i class="bi bi-check2-circle me-1"></i>Ngày duyệt: @don.NgayDuyet.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(don.LyDoTuChoi))
                                {
                                    <div class="alert alert-danger py-1 px-2 mt-2 small mb-0">
                                        <i class="bi bi-x-circle me-1"></i>Lý do từ chối: @don.LyDoTuChoi
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(don.NguoiDuyet))
                                {
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-person-check me-1"></i>Người duyệt: @don.NguoiDuyet
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
