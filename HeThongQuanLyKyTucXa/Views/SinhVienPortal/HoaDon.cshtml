@using KyTucXaManagement.Models
@model List<HoaDon>
@{
    ViewData["Title"] = "Hóa đơn của tôi";
    var sinhVien = ViewBag.SinhVien as SinhVien;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt me-2 text-primary"></i>Hóa đơn của tôi</h4>
        @if (sinhVien != null)
        {
            <p class="text-muted small mb-0">Sinh viên: <strong>@sinhVien.HoTen</strong> — Mã SV: @sinhVien.MaSinhVien</p>
        }
    </div>
    <a asp-controller="SinhVienPortal" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<!-- Thống kê nhanh -->
@if (Model != null && Model.Any())
{
    var tongChuaThanhToan = Model.Where(h => h.TrangThai == "Chưa thanh toán").Sum(h => h.TongTien);
    var tongDaThanhToan = Model.Where(h => h.TrangThai == "Đã thanh toán").Sum(h => h.TongTien);
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card orange text-center py-3">
                <div class="stat-number text-warning">@Model.Count(h => h.TrangThai == "Chưa thanh toán")</div>
                <div class="text-muted small">Hóa đơn chưa thanh toán</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card red text-center py-3">
                <div class="stat-number text-danger">@tongChuaThanhToan.ToString("N0") đ</div>
                <div class="text-muted small">Tổng nợ</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card green text-center py-3">
                <div class="stat-number text-success">@Model.Count(h => h.TrangThai == "Đã thanh toán")</div>
                <div class="text-muted small">Đã thanh toán</div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Mã hóa đơn</th>
                        <th>Tháng/Năm</th>
                        <th>Tiền phòng</th>
                        <th>Tiền điện</th>
                        <th>Tiền nước</th>
                        <th>Phí khác</th>
                        <th class="fw-bold">Tổng tiền</th>
                        <th>Hạn TT</th>
                        <th>Ngày TT</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Chưa có hóa đơn nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var hd in Model)
                        {
                            bool quaHan = hd.TrangThai == "Chưa thanh toán" && hd.HanThanhToan.HasValue && hd.HanThanhToan < DateTime.Now;
                            <tr class="@(quaHan ? "table-danger" : "")">
                                <td class="text-muted small">@(stt++)</td>
                                <td><code class="small">@hd.MaHoaDon</code></td>
                                <td>@hd.Thang/@hd.Nam</td>
                                <td>@hd.TienPhong.ToString("N0") đ</td>
                                <td>@hd.TienDien.ToString("N0") đ</td>
                                <td>@hd.TienNuoc.ToString("N0") đ</td>
                                <td>@hd.PhiKhac.ToString("N0") đ</td>
                                <td class="fw-bold text-primary">@hd.TongTien.ToString("N0") đ</td>
                                <td class="small @(quaHan ? "text-danger fw-semibold" : "")">
                                    @(hd.HanThanhToan.HasValue ? hd.HanThanhToan.Value.ToString("dd/MM/yyyy") : "—")
                                    @if (quaHan) { <span class="badge bg-danger ms-1">Quá hạn</span> }
                                </td>
                                <td class="small">@(hd.NgayThanhToan.HasValue ? hd.NgayThanhToan.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td>
                                    @if (hd.TrangThai == "Đã thanh toán")
                                    {
                                        <span class="badge" style="background:#D1FAE5;color:#065F46">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else if (quaHan)
                                    {
                                        <span class="badge" style="background:#FEE2E2;color:#991B1B">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#FEF3C7;color:#92400E">
                                            <i class="bi bi-clock-fill me-1"></i>Chưa thanh toán
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        @if (hd.TrangThai != "Đã thanh toán")
                                        {
                                            <button type="button" class="btn btn-sm btn-success"
                                                    onclick="xacNhanThanhToan(@hd.Id, '@hd.MaHoaDon', '@hd.TongTien.ToString("N0")')">
                                                <i class="bi bi-credit-card-fill me-1"></i>Thanh toán
                                            </button>
                                        }
                                        <a asp-controller="HoaDon" asp-action="Print" asp-route-id="@hd.Id"
                                           target="_blank" class="btn btn-sm btn-outline-dark" title="In hóa đơn">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Tổng: <strong>@(Model?.Count ?? 0)</strong> hóa đơn
    </div>
</div>

<!-- Modal xác nhận thanh toán -->
<div class="modal fade" id="modalThanhToan" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-credit-card-fill text-success me-2"></i>Xác nhận thanh toán
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Vui lòng xác nhận bạn đã thanh toán hóa đơn này.
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted">Mã hóa đơn</span>
                    <code id="modalMaHD"></code>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted">Số tiền</span>
                    <span class="fw-bold fs-5 text-primary" id="modalSoTien"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <form id="formThanhToan" asp-controller="SinhVienPortal" asp-action="ThanhToanHoaDon" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="hdIdInput" />
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-check-circle-fill me-1"></i>Xác nhận đã thanh toán
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function xacNhanThanhToan(id, maHD, soTien) {
        document.getElementById('hdIdInput').value = id;
        document.getElementById('modalMaHD').textContent = maHD;
        document.getElementById('modalSoTien').textContent = soTien + 'đ';
        new bootstrap.Modal(document.getElementById('modalThanhToan')).show();
    }
</script>
}
