@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản Lý Ký Túc Xá</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* ─── LEFT PANEL ─── */
        .login-left {
            width: 55%;
            background: linear-gradient(145deg, #1E3A8A 0%, #1E40AF 45%, #1D4ED8 100%);
            position: relative;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
        }
        .login-left::before {
            content: '';
            position: absolute; inset: 0;
            background:
                radial-gradient(circle at 20% 30%, rgba(99,102,241,.35) 0%, transparent 55%),
                radial-gradient(circle at 80% 70%, rgba(16,185,129,.2) 0%, transparent 50%);
        }
        /* Decorative shapes */
        .shape {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.08);
        }
        .shape-1 { width: 340px; height: 340px; top: -80px; left: -80px; }
        .shape-2 { width: 220px; height: 220px; bottom: 60px; right: -50px; }
        .shape-3 { width: 130px; height: 130px; bottom: 200px; left: 60px; }

        .left-content {
            position: relative; z-index: 2;
            text-align: center; padding: 40px;
            max-width: 420px;
        }
        .left-logo {
            width: 90px; height: 90px;
            background: rgba(255,255,255,.12);
            border: 2px solid rgba(255,255,255,.2);
            border-radius: 28px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 2.8rem; color: #fff;
            margin-bottom: 24px;
            backdrop-filter: blur(8px);
        }
        .left-title {
            color: #fff;
            font-size: 1.9rem; font-weight: 800;
            line-height: 1.2; margin-bottom: 12px;
        }
        .left-sub {
            color: rgba(255,255,255,.6);
            font-size: 0.92rem; line-height: 1.6;
        }
        .feature-list {
            margin-top: 36px; text-align: left;
            list-style: none; display: flex; flex-direction: column; gap: 12px;
        }
        .feature-list li {
            display: flex; align-items: center; gap: 12px;
            color: rgba(255,255,255,.8); font-size: 0.87rem;
        }
        .feature-list li .fi {
            width: 34px; height: 34px;
            background: rgba(255,255,255,.1);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; color: #fff; flex-shrink: 0;
        }

        /* ─── RIGHT PANEL ─── */
        .login-right {
            width: 45%;
            background: #F8FAFC;
            display: flex; align-items: center; justify-content: center;
            padding: 40px 24px;
        }
        .login-box {
            width: 100%; max-width: 400px;
        }
        .login-box-header {
            margin-bottom: 32px;
        }
        .login-box-header .welcome {
            font-size: 0.82rem; font-weight: 600;
            color: #2563EB; letter-spacing: .5px;
            text-transform: uppercase; margin-bottom: 6px;
        }
        .login-box-header h2 {
            font-size: 1.75rem; font-weight: 800;
            color: #1E293B; margin-bottom: 6px;
        }
        .login-box-header p {
            color: #64748B; font-size: 0.87rem;
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 4px 32px rgba(0,0,0,.08), 0 1px 8px rgba(0,0,0,.04);
            border: 1px solid #E2E8F0;
        }

        .form-group-label {
            font-size: 0.82rem; font-weight: 700;
            color: #374151; margin-bottom: 7px; display: block;
        }
        .input-wrap {
            position: relative;
        }
        .input-wrap .input-icon {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: #94A3B8; font-size: 1rem; pointer-events: none;
            z-index: 2;
        }
        .input-wrap input {
            width: 100%;
            padding: 11px 42px 11px 40px;
            border: 1.5px solid #E2E8F0;
            border-radius: 12px;
            font-size: 0.9rem;
            background: #F8FAFC;
            color: #1E293B;
            outline: none;
            transition: all .2s;
        }
        .input-wrap input:focus {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }
        .input-wrap .toggle-pw {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #94A3B8;
            cursor: pointer; padding: 2px 6px;
            font-size: 0.95rem;
            transition: color .2s;
        }
        .input-wrap .toggle-pw:hover { color: #2563EB; }

        .remember-row {
            display: flex; align-items: center; justify-content: space-between;
            margin: 16px 0 22px;
        }
        .remember-row label {
            display: flex; align-items: center; gap: 7px;
            font-size: 0.83rem; color: #475569; cursor: pointer;
        }
        .remember-row label input[type=checkbox] {
            width: 15px; height: 15px;
            accent-color: #2563EB; cursor: pointer;
        }

        .btn-login-main {
            width: 100%; padding: 13px;
            background: linear-gradient(135deg, #2563EB, #1E40AF);
            border: none; border-radius: 12px;
            color: #fff; font-size: 0.95rem; font-weight: 700;
            cursor: pointer; transition: all .2s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-login-main:hover {
            background: linear-gradient(135deg, #1E40AF, #1E3A8A);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(37,99,235,.4);
        }
        .btn-login-main:active { transform: translateY(0); }

        .login-hint {
            margin-top: 20px;
            padding: 12px 16px;
            background: #EFF6FF;
            border-radius: 10px;
            border-left: 3px solid #2563EB;
            font-size: 0.8rem; color: #1E40AF;
        }
        .login-hint strong { font-weight: 700; }

        .alert-error {
            background: #FEE2E2;
            border: none; border-left: 3px solid #EF4444;
            border-radius: 10px;
            padding: 10px 14px;
            color: #991B1B;
            font-size: 0.83rem;
            margin-bottom: 20px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { width: 100%; background: linear-gradient(145deg, #1E3A8A, #1D4ED8); padding: 24px 16px; }
            .login-card { padding: 24px; }
            .login-box-header h2 { font-size: 1.4rem; }
            .login-box-header .welcome, .login-box-header p { color: rgba(255,255,255,.7); }
            .login-box-header h2 { color: #fff; }
        }
    </style>
</head>
<body>
    <div class="login-left d-none d-md-flex">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="left-content">
            <div class="left-logo">
                <i class="bi bi-buildings-fill"></i>
            </div>
            <h1 class="left-title">Hệ Thống Quản Lý<br/>Ký Túc Xá</h1>
            <p class="left-sub">Nền tảng quản lý toàn diện — từ phòng ở, hóa đơn đến tài sản và sự cố.</p>
            <ul class="feature-list">
                <li>
                    <span class="fi"><i class="bi bi-people-fill"></i></span>
                    <span>Quản lý sinh viên & phân phòng thông minh</span>
                </li>
                <li>
                    <span class="fi"><i class="bi bi-receipt-cutoff"></i></span>
                    <span>Tự động lập hóa đơn điện, nước, phòng</span>
                </li>
                <li>
                    <span class="fi"><i class="bi bi-tools"></i></span>
                    <span>Theo dõi tài sản và xử lý sự cố nhanh chóng</span>
                </li>
                <li>
                    <span class="fi"><i class="bi bi-bar-chart-line-fill"></i></span>
                    <span>Thống kê và báo cáo trực quan</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="login-right">
        <div class="login-box">
            <div class="login-box-header">
                <p class="welcome">HUTECH · KTX Management</p>
                <h2>Đăng nhập</h2>
                <p>Nhập thông tin để truy cập hệ thống</p>
            </div>

            <div class="login-card">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        @Html.ValidationSummary(false, "", new { @class = "mb-0 d-inline" })
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-4">
                        <label class="form-group-label">
                            Tài khoản <span style="color:#94A3B8;font-weight:400">(MSSV hoặc Email)</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="bi bi-person-circle"></i></span>
                            <input type="text" name="loginInput"
                                   placeholder="VD: 2380614779 hoặc email..."
                                   required autocomplete="username" />
                        </div>
                    </div>

                    <div class="mb-1">
                        <label class="form-group-label">Mật khẩu</label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="bi bi-lock-fill"></i></span>
                            <input type="password" name="password" id="inputPassword"
                                   placeholder="Nhập mật khẩu..."
                                   required autocomplete="current-password" />
                            <button type="button" class="toggle-pw" id="togglePassword" tabindex="-1">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="remember-row">
                        <label>
                            <input type="checkbox" name="rememberMe" id="rememberMe" />
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <button type="submit" class="btn-login-main">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Đăng nhập
                    </button>
                </form>

                <div class="login-hint mt-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Sinh viên dùng <strong>MSSV</strong> hoặc <strong>Gmail</strong> &nbsp;·&nbsp;
                    Nhân viên / Admin dùng <strong>Email</strong>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('inputPassword');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
</body>
</html>
