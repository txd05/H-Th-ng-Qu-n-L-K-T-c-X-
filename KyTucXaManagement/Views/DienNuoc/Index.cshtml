@{
    ViewData["Title"] = "Quản lý điện / nước";
    var chiSoDiens = ViewBag.ChiSoDiens as List<KyTucXaManagement.Models.ChiSoDien> ?? new();
    var chiSoNuocs = ViewBag.ChiSoNuocs as List<KyTucXaManagement.Models.ChiSoNuoc> ?? new();
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <input type="number" name="thang" class="form-control form-control-sm" placeholder="Tháng" value="@ViewBag.Thang" min="1" max="12" />
            </div>
            <div class="col-md-2">
                <input type="number" name="nam" class="form-control form-control-sm" placeholder="Năm" value="@ViewBag.Nam" />
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-filter"></i> Xem</button>
                <a asp-action="CreateDien" class="btn btn-warning btn-sm ms-auto">
                    <i class="bi bi-lightning-charge"></i> Ghi điện
                </a>
                <a asp-action="CreateNuoc" class="btn btn-info btn-sm text-white">
                    <i class="bi bi-droplet"></i> Ghi nước
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark d-flex justify-content-between">
                <span><i class="bi bi-lightning-charge me-2"></i>Chỉ số điện - @ViewBag.Thang/@ViewBag.Nam</span>
                <span class="badge bg-dark">@chiSoDiens.Count phòng</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Phòng</th><th>Đầu</th><th>Cuối</th><th>Tiêu thụ</th><th>Thành tiền</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cs in chiSoDiens)
                        {
                            var tieu = cs.ChiSoCuoi - cs.ChiSoDau;
                            <tr>
                                <td><b>@cs.Phong?.MaPhong</b></td>
                                <td>@cs.ChiSoDau</td>
                                <td>@cs.ChiSoCuoi</td>
                                <td>@tieu kWh</td>
                                <td>@string.Format("{0:N0}", tieu * cs.DonGia)đ</td>
                                <td>
                                    <form asp-action="DeleteDien" asp-route-id="@cs.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-xs btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!chiSoDiens.Any()) { <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span><i class="bi bi-droplet me-2"></i>Chỉ số nước - @ViewBag.Thang/@ViewBag.Nam</span>
                <span class="badge bg-dark">@chiSoNuocs.Count phòng</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Phòng</th><th>Đầu</th><th>Cuối</th><th>Tiêu thụ</th><th>Thành tiền</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cs in chiSoNuocs)
                        {
                            var tieu = cs.ChiSoCuoi - cs.ChiSoDau;
                            <tr>
                                <td><b>@cs.Phong?.MaPhong</b></td>
                                <td>@cs.ChiSoDau</td>
                                <td>@cs.ChiSoCuoi</td>
                                <td>@tieu m³</td>
                                <td>@string.Format("{0:N0}", tieu * cs.DonGia)đ</td>
                                <td>
                                    <form asp-action="DeleteNuoc" asp-route-id="@cs.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-xs btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!chiSoNuocs.Any()) { <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
