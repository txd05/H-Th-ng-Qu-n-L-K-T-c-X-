@model KyTucXaManagement.Models.ChiSoNuoc
@{
    ViewData["Title"] = "Ghi chỉ số nước";
}
<div class="card" style="max-width:500px">
    <div class="card-header bg-info text-white"><i class="bi bi-droplet me-2"></i>Ghi chỉ số nước</div>
    <div class="card-body">
        <form asp-action="CreateNuoc" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PhongId" class="form-label fw-semibold small">Phòng</label>
                    <select asp-for="PhongId" asp-items="ViewBag.Phongs" class="form-select form-select-sm">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Thang" class="form-label fw-semibold small"></label>
                    <input asp-for="Thang" class="form-control form-control-sm" type="number" min="1" max="12" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Nam" class="form-label fw-semibold small"></label>
                    <input asp-for="Nam" class="form-control form-control-sm" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ChiSoDau" class="form-label fw-semibold small"></label>
                    <input asp-for="ChiSoDau" class="form-control form-control-sm" type="number" step="0.1" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ChiSoCuoi" class="form-label fw-semibold small"></label>
                    <input asp-for="ChiSoCuoi" class="form-control form-control-sm" type="number" step="0.1" />
                    <span asp-validation-for="ChiSoCuoi" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DonGia" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="DonGia" class="form-control" type="number" />
                        <span class="input-group-text">đ/m³</span>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-info text-white"><i class="bi bi-save me-1"></i>Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
