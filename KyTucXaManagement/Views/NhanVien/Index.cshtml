@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-person-badge me-2 text-primary"></i>Quản lý Nhân viên</h4>
        <p class="text-muted small mb-0">Danh sách tài khoản nhân viên trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Thêm nhân viên
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Email</th>
                        <th>Username</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Chưa có nhân viên nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var nv in Model)
                        {
                            bool biKhoa = nv.LockoutEnd.HasValue && nv.LockoutEnd > DateTimeOffset.UtcNow;
                            <tr>
                                <td class="text-muted small">@(stt++)</td>
                                <td>
                                    <i class="bi bi-envelope me-1 text-muted"></i>@nv.Email
                                </td>
                                <td class="text-muted small">@nv.UserName</td>
                                <td>
                                    @if (biKhoa)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock me-1"></i>Bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                                        <!-- Khóa / Mở khóa -->
                                        <form asp-action="ToggleKhoa" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm @(biKhoa ? "btn-outline-success" : "btn-outline-warning")"
                                                    onclick="return confirm('@(biKhoa ? "Mở khóa tài khoản này?" : "Khóa tài khoản này?")')">
                                                <i class="bi @(biKhoa ? "bi-unlock" : "bi-lock")"></i>
                                                @(biKhoa ? "Mở khóa" : "Khóa")
                                            </button>
                                        </form>

                                        <!-- Reset mật khẩu -->
                                        <form asp-action="ResetPassword" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-info"
                                                    onclick="return confirm('Reset mật khẩu về NhanVien@123?')">
                                                <i class="bi bi-key"></i> Reset MK
                                            </button>
                                        </form>

                                        <!-- Xóa -->
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@nv.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Xóa vĩnh viễn tài khoản @nv.Email?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Tổng: <strong>@(Model?.Count ?? 0)</strong> nhân viên
    </div>
</div>
