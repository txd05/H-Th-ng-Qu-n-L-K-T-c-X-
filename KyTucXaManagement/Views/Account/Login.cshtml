@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản Lý Ký Túc Xá</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background: linear-gradient(135deg, #1e3a5f 0%, #2980b9 100%); min-height: 100vh; display: flex; align-items: center; }
        .login-card { border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); border: none; }
        .login-card .card-header { background: #1e3a5f; border-radius: 16px 16px 0 0; padding: 28px; }
        .form-control { border-radius: 8px; padding: 10px 14px; }
        .btn-login { background: #1e3a5f; border: none; border-radius: 8px; padding: 12px; font-weight: 600; }
        .btn-login:hover { background: #2980b9; }
        .demo-box { background: #f8f9fa; border-radius: 8px; font-size: 0.82rem; }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card">
                    <div class="card-header text-center">
                        <i class="bi bi-building text-white fs-1"></i>
                        <h5 class="text-white mt-2 mb-0">Hệ Thống Quản Lý</h5>
                        <p class="text-white-50 small mb-0">Ký Túc Xá HUTECH</p>
                    </div>
                    <div class="card-body p-4">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small">
                                <i class="bi bi-exclamation-circle me-1"></i>
                                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            </div>
                        }
                        <form asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input type="email" name="email" class="form-control" placeholder="Nhập email..." required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu..." required />
                                </div>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe" />
                                <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>
                            <button type="submit" class="btn btn-login btn-primary w-100">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                            </button>
                        </form>
                        <div class="demo-box p-3 mt-3">
                            <p class="fw-semibold mb-2 text-muted">Tài khoản demo:</p>
                            <div><span class="badge bg-danger me-1">Admin</span> admin@ktx.edu.vn / Admin@123</div>
                            <div class="mt-1"><span class="badge bg-primary me-1">NV</span> nhanvien@ktx.edu.vn / NhanVien@123</div>
                            <div class="mt-1"><span class="badge bg-primary me-1">NV</span> nv.tran@ktx.edu.vn / NhanVien2@123</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
