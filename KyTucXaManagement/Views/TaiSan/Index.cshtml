@model IEnumerable<KyTucXaManagement.Models.TaiSan>
@{
    ViewData["Title"] = "Quản lý tài sản";
}
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 align-items-center">
            <a asp-action="Create" class="btn btn-success btn-sm"><i class="bi bi-plus-circle me-1"></i>Thêm tài sản</a>
            <a asp-action="SuCo" class="btn btn-outline-danger btn-sm"><i class="bi bi-tools me-1"></i>Sự cố</a>
            <select class="form-select form-select-sm ms-auto" style="max-width:200px"
                    onchange="location.href='?tinhTrang='+this.value">
                <option value="">-- Tình trạng --</option>
                <option value="Bình thường">Bình thường</option>
                <option value="Hỏng">Hỏng</option>
                <option value="Đang sửa">Đang sửa</option>
            </select>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between">
        <span><i class="bi bi-box-seam me-2 text-warning"></i>Danh sách tài sản</span>
        <span class="badge bg-warning text-dark">@Model.Count() tài sản</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Mã TS</th><th>Tên tài sản</th><th>Loại</th><th>Phòng</th><th>SL</th><th>Giá trị</th><th>Tình trạng</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var ts in Model)
                {
                    <tr>
                        <td><code>@ts.MaTaiSan</code></td>
                        <td>@ts.TenTaiSan</td>
                        <td>@ts.LoaiTaiSan</td>
                        <td>@ts.Phong?.MaPhong</td>
                        <td>@ts.SoLuong</td>
                        <td>@string.Format("{0:N0}đ", ts.GiaTri)</td>
                        <td>
                            <span class="badge @(ts.TinhTrang == "Bình thường" ? "bg-success" : ts.TinhTrang == "Hỏng" ? "bg-danger" : "bg-warning text-dark")">
                                @ts.TinhTrang
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@ts.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@ts.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa tài sản?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="8" class="text-center py-4 text-muted">Chưa có tài sản nào.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
