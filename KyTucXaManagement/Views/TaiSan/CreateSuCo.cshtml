@model KyTucXaManagement.Models.SuCoTaiSan
@{
    ViewData["Title"] = "Báo sự cố tài sản";
}
<div class="card" style="max-width:600px">
    <div class="card-header bg-danger text-white"><i class="bi bi-tools me-2"></i>Báo sự cố tài sản</div>
    <div class="card-body">
        <form asp-action="CreateSuCo" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="TaiSanId" class="form-label fw-semibold small">Tài sản</label>
                    <select asp-for="TaiSanId" asp-items="ViewBag.TaiSans" class="form-select form-select-sm">
                        <option value="">-- Chọn tài sản --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="MucDo" class="form-label fw-semibold small"></label>
                    <select asp-for="MucDo" class="form-select form-select-sm">
                        <option>Nhẹ</option><option>Vừa</option><option>Nặng</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="MoTaSuCo" class="form-label fw-semibold small"></label>
                    <textarea asp-for="MoTaSuCo" class="form-control form-control-sm" rows="3" placeholder="Mô tả chi tiết sự cố..."></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-save me-1"></i>Báo sự cố</button>
                <a asp-action="SuCo" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
