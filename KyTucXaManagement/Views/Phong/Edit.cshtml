@model KyTucXaManagement.Models.Phong
@{
    ViewData["Title"] = "Chỉnh sửa phòng";
}
<div class="card" style="max-width:600px">
    <div class="card-header bg-warning text-dark"><i class="bi bi-pencil me-2"></i>Chỉnh sửa phòng @Model.MaPhong</div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SoNguoiHienTai" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaPhong" class="form-label fw-semibold small"></label>
                    <input asp-for="MaPhong" class="form-control form-control-sm" />
                    <span asp-validation-for="MaPhong" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LoaiPhong" class="form-label fw-semibold small"></label>
                    <select asp-for="LoaiPhong" class="form-select form-select-sm">
                        <option>4 người</option><option>6 người</option><option>8 người</option><option>2 người</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="SucChua" class="form-label fw-semibold small"></label>
                    <input asp-for="SucChua" class="form-control form-control-sm" type="number" min="1" />
                    <span asp-validation-for="SucChua" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Tang" class="form-label fw-semibold small"></label>
                    <input asp-for="Tang" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ToaNha" class="form-label fw-semibold small"></label>
                    <input asp-for="ToaNha" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="GioiTinh" class="form-label fw-semibold small"></label>
                    <select asp-for="GioiTinh" class="form-select form-select-sm">
                        <option>Nam</option><option>Nữ</option><option>Hỗn hợp</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="GiaPhong" class="form-label fw-semibold small"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="GiaPhong" class="form-control" type="number" />
                        <span class="input-group-text">đ/tháng</span>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="TrangThai" class="form-label fw-semibold small"></label>
                    <select asp-for="TrangThai" class="form-select form-select-sm">
                        <option>Còn chỗ</option><option>Đầy</option><option>Đang sửa chữa</option><option>Đóng cửa</option>
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Cập nhật</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
