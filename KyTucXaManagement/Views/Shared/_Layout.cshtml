<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Ký Túc Xá</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root { --sidebar-width: 250px; --primary: #1e3a5f; --accent: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); min-height: 100vh; background: var(--primary);
            position: fixed; top: 0; left: 0; z-index: 1000; overflow-y: auto;
        }
        .sidebar .brand { padding: 20px 16px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar .brand h6 { color: #fff; font-weight: 700; font-size: 0.85rem; margin: 0; }
        .sidebar .brand p { color: rgba(255,255,255,0.5); font-size: 0.72rem; margin: 0; }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.75); padding: 10px 16px; font-size: 0.875rem;
            border-radius: 6px; margin: 2px 8px; transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #fff; background: rgba(255,255,255,0.15);
        }
        .sidebar .nav-link i { width: 20px; }
        .sidebar .section-title {
            color: rgba(255,255,255,0.4); font-size: 0.7rem; font-weight: 600;
            letter-spacing: 1px; padding: 12px 24px 4px; text-transform: uppercase;
        }
        .main-content { margin-left: var(--sidebar-width); }
        .topbar {
            background: #fff; padding: 12px 24px; border-bottom: 1px solid #e9ecef;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 999;
        }
        .page-content { padding: 24px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .card-header { border-radius: 12px 12px 0 0 !important; font-weight: 600; }
        .stat-card { border-left: 4px solid; }
        .stat-card.blue { border-color: #0d6efd; }
        .stat-card.green { border-color: #198754; }
        .stat-card.orange { border-color: #fd7e14; }
        .stat-card.red { border-color: #dc3545; }
        .stat-card.purple { border-color: #6f42c1; }
        .stat-card.teal { border-color: #20c997; }
        .stat-number { font-size: 1.8rem; font-weight: 700; }
        .badge-trang-thai { font-size: 0.78rem; }
        .table th { font-weight: 600; font-size: 0.85rem; color: #495057; }
        .btn-sm { font-size: 0.8rem; }
        .alert { border-radius: 10px; }
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="sidebar">
            <div class="brand">
                <h6><i class="bi bi-building me-2"></i>KTX Management</h6>
                <p>Ký Túc Xá HUTECH</p>
            </div>
            <nav class="mt-2">
                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                {
                    <div class="section-title">Tổng quan</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ThongKe" ? "active" : "")" asp-controller="Admin" asp-action="ThongKe">
                        <i class="bi bi-bar-chart-line"></i> Thống kê SV
                    </a>

                    <div class="section-title">Quản lý</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")" asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-people"></i> Sinh viên
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Phong" ? "active" : "")" asp-controller="Phong" asp-action="Index">
                        <i class="bi bi-door-open"></i> Phòng
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" ? "active" : "")" asp-controller="HoaDon" asp-action="Index">
                        <i class="bi bi-receipt"></i> Hóa đơn
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienNuoc" ? "active" : "")" asp-controller="DienNuoc" asp-action="Index">
                        <i class="bi bi-lightning-charge"></i> Điện / Nước
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaiSan" ? "active" : "")" asp-controller="TaiSan" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Tài sản
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SuCo" ? "active" : "")" asp-controller="TaiSan" asp-action="SuCo">
                        <i class="bi bi-tools"></i> Sự cố
                    </a>
                }
                else
                {
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Trang chủ
                    </a>
                }
            </nav>
        </div>
    }

    <div class="@(User.Identity?.IsAuthenticated == true ? "main-content" : "")">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="topbar">
                <div>
                    <h6 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h6>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="@(User.Identity?.IsAuthenticated == true ? "page-content" : "")">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
